package components 

templ Index(title string) {
    @Layout(title) {
        @ProfileCard()
        <p class="text-gray-500 mb-4">Hey, I'm Jack!</p> 
        <p class="mb-4 text-gray-500">
            I'm a self-taught programmer with a love for the low-tech fever-dream of early-modern computing. I love a POSIX compliant CLI, the DIY of my home-lab, technological minimalism and the creative re-use of age-old paradigms. I need to know how a system works, from top to bottom. I probably consume too many <a class="hover:text-purple-400 text-gray-300" rel="noopener noreferrer" target="_blank" href="https://www.youtube.com/watch?v=CgdKYBqe6QA">Jonathan Blow</a> takes.
        </p>
        <p class="mb-4 text-gray-500">
            <span>I'm always eager to take on new opportunity and expand my skillset;</span> 
            <a class="text-gray-800 cursor-pointer hover:text-purple-400" href="/static/doc/cv.md" download rel="noopener noreferrer" target="_blank">download my CV</a>
            <span>, check out my Github and </span>
            <a class="text-gray-800 cursor-pointer hover:text-purple-400" href="mailto:self@jabenne.net">drop me a line</a>
            <span>{`if you think I'd be a good fit for your team, or if you'd like to work on something together!`}</span>
        </p>
        <hr class="h-px my-6 bg-gray-200 border-0 dark:bg-gray-700"/>
        @NavPanel()
    }
}

templ ProfileCard() {
    <div class="flex flex-col gap-2.5 mb-4">
        <img src="/static/img/portrait.png" class="h-48 w-48"/>
        <div class="flex flex-col">
            <span class="text-lg">Jack Bennett</span>
            <div hx-get="/presence" hx-trigger="load" class="h-10">
                @Presence("offline", nil)
            </div>
        </div>
    </div>
}

templ NavPanel() {
    <div class="flex gap-2.5 items-center mt-2 pb-10">
        <a href="mailto:self@jabenne.net" class="text-gray-400 hover:underline hover:text-gray-500 text-sm cursor-pointer font-mono">self@jabenne.net</a>
        <a class="ml-auto" rel="noopener noreferrer" target="_blank" href="https://github.com/jabenne">
            @GithubIcon("w-5 h-5 text-gray-800 hover:text-purple-400 cursor-pointer")
        </a>
        <a href="https://www.linkedin.com/in/jack-bennett-78874b205/" rel="noopener noreferrer" target="_blank">
            @LinkedinIcon("w-5 h-5 text-gray-800 hover:text-purple-400 cursor-pointer")
        </a>
    </div>
}

script Copy(event templ.JSExpression, command string, args string) {
   !window.s?s=command+' '+args:null;navigator.clipboard.writeText(s);
   event.target.textContent='COPIED!';
}

templ CliCopy(command string, args string) {
    <div class="flex flex-row text-sm gap-2 rounded-md mb-3 py-2 font-mono">
        <span class="text-fuchsia-400">$</span>
        <span class="text-violet-400">{ command }</span>
        <span class="text-gray-600">{ args }</span>
      <div class="text-gray-400 hover:text-gray-500 ml-auto cursor-pointer" hx-on:click={ Copy(templ.JSExpression("event"), command, args)}>COPY</div>
    </div>
}
